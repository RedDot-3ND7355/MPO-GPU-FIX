<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <RootNamespace>AMDGPUFIX</RootNamespace>
    <AssemblyName>MPOGPUFIX</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>mpo-icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <StartupObject>AMDGPUFIX.Program</StartupObject>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- File version still comes from Properties\AssemblyInfo.cs -->
    <ApplicationVersion>7.5.0</ApplicationVersion>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="mpo-icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ReaLTaiizor" Version="3.8.2.1" />
    <PackageReference Include="System.Management" Version="10.0.10" />
  </ItemGroup>
</Project>
